# Copie este arquivo para .env e preencha com os valores do SEU ambiente.
# NUNCA coloque credenciais reais aqui: .env.example e versionado no Git.

SPRING_PROFILES_ACTIVE=dev

DB_URL=jdbc:mysql://localhost:3306/dk_db?useSSL=false&serverTimezone=America/Sao_Paulo&allowPublicKeyRetrieval=true
DB_DRIVER=com.mysql.cj.jdbc.Driver
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME

JPA_DDL_AUTO=update
JPA_SHOW_SQL=true
JPA_FORMAT_SQL=true

APP_DATABASE_MONITORING_ENABLED=true
APP_DATABASE_VALIDATION_ENABLED=true
APP_DATABASE_LOG_DETAILS_ENABLED=true
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200,http://localhost:5173

APP_SECURITY_ENABLED=true
APP_SECURITY_PUBLIC_DOCS_ENABLED=true
# Gere o seu com: openssl rand -base64 48
# Se ficar vazio, em dev a aplicacao gera uma chave efemera por execucao;
# em prod a aplicacao nao sobe sem este valor.
APP_SECURITY_JWT_SECRET=
APP_SECURITY_JWT_EXPIRATION_SECONDS=14400
APP_SECURITY_REFRESH_TOKEN_EXPIRATION_SECONDS=604800

FLYWAY_ENABLED=false

# --- Google Calendar -------------------------------------------------------
# Obtidos no Google Cloud Console (OAuth 2.0 Client ID, tipo "Desktop app").
# NUNCA preencha com valores reais neste arquivo: ele e versionado.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_CALENDAR_ID=

# Opcionais
GOOGLE_REFRESH_TOKEN=
GOOGLE_TOKENINFO_TIMEOUT_MS=5000

# --- Servidor de WhatsApp --------------------------------------------------
WHATSAPP_API_URL=http://localhost:3002
WHATSAPP_API_KEY=
WHATSAPP_DEFAULT_SESSION_ID=
