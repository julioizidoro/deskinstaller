#!/bin/bash
# ---------------------------------------------------------------------------
# Modelo de configuracao da DeskInstaller API em Tomcat externo.
#
# Copie para $CATALINA_HOME/bin/setenv.sh, preencha os valores e proteja:
#     chmod 700 $CATALINA_HOME/bin/setenv.sh
#     chown tomcat:tomcat $CATALINA_HOME/bin/setenv.sh
#
# NUNCA versione o setenv.sh preenchido: ele contem senha e segredo.
# ---------------------------------------------------------------------------

export SPRING_PROFILES_ACTIVE='prod'

# --- Banco de dados (MySQL no mesmo servidor) ------------------------------
export DB_URL='jdbc:mysql://localhost:3306/dk_db?useSSL=false&serverTimezone=America/Sao_Paulo&allowPublicKeyRetrieval=true'
export DB_DRIVER='com.mysql.cj.jdbc.Driver'
export DB_USERNAME='CHANGE_ME'
export DB_PASSWORD='CHANGE_ME'

# Em producao o schema nunca e alterado pelo Hibernate.
export JPA_DDL_AUTO='validate'

# --- Seguranca -------------------------------------------------------------
export APP_SECURITY_ENABLED='true'
export APP_SECURITY_PUBLIC_DOCS_ENABLED='false'

# Gere com: openssl rand -base64 48
# A aplicacao NAO sobe em prod sem este valor, e recusa os segredos de exemplo.
export APP_SECURITY_JWT_SECRET='CHANGE_ME'
export APP_SECURITY_JWT_EXPIRATION_SECONDS='3600'
export APP_SECURITY_REFRESH_TOKEN_EXPIRATION_SECONDS='604800'

# Origens reais do front-end. Nao pode ser '*' nem apenas localhost.
export APP_CORS_ALLOWED_ORIGINS='https://CHANGE_ME'

# --- Operacional -----------------------------------------------------------
export APP_DATABASE_MONITORING_ENABLED='false'

# Banco legado ja tem as tabelas: ligue o Flyway so apos fazer o baseline.
export FLYWAY_ENABLED='false'

# --- Google Calendar -------------------------------------------------------
export GOOGLE_CLIENT_ID='CHANGE_ME'
export GOOGLE_CLIENT_SECRET='CHANGE_ME'
export GOOGLE_REFRESH_TOKEN='CHANGE_ME'
export GOOGLE_CALENDAR_ID='CHANGE_ME'

# --- JVM -------------------------------------------------------------------
export CATALINA_OPTS="$CATALINA_OPTS -Xms512m -Xmx1024m -Duser.timezone=America/Sao_Paulo"
